{
  "name": "school-life-simulator",
  "version": "1.0.0",
  "private": true,
  "description": "School life simulation game in one self-contained HTML file (EN/FR).",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:check": "node scripts/build.mjs --check",
    "fr": "node scripts/mergefr.mjs",
    "fr:check": "node scripts/mergefr.mjs --check",
    "test": "npm run test:golden && node tests/engine_smoke.js",
    "test:unit": "node --test \"tests/unit/**/*.test.js\"",
    "test:golden": "node tests/golden.js",
    "test:e2e": "npm run build && node scripts/e2e.mjs",
    "lint": "eslint . && node scripts/lint-bundles.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "prettier": "3.9.10"
  }
}
